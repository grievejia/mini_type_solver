# verdict: unsatisfiable
# Source: pyrefly/lib/test/generic_restrictions.rs:954
#   test_arg_against_typevar_bound
# Pyrefly: `reduce(f, [1])` is an error (`int` is not assignable to upper
# bound `str` of type variable `_T`). `reduce(f, ["ok"])` is accepted.
#
#   reduce[_S](function: Callable[[_S, _S], _S], iterable: Iterable[_S]) -> _S
#   f[_T: str](arg1: _T, arg2: _T) -> _T
#
# Each call gives `_S` a fresh metavariable. Each argument check is one
# assertion. The argument `f` is a generic function value, so it keeps its
# `forall`. To fit (?S, ?S) -> ?S, the solver selects _T, and ?S must then
# equal that selection inside the bound `str`. The covariant Iterable
# carries the list element into ?S. For [1], ?S must hold int and also stay
# inside str. The core is the two assertions of the failing call.
# Approximation: each list display has its own type (list[int], list[str]).
class int;
class str;
class Iterable[+T];
class list[T] extends Iterable[T];
metavar ?int_S;
metavar ?ok_S;

# reduce(f, [1])  -- error
assert int_function: forall T <: str. (T, T) -> T <: (?int_S, ?int_S) -> ?int_S;
assert int_iterable: list[int] <: Iterable[?int_S];

# reduce(f, ["ok"])
assert ok_function: forall T <: str. (T, T) -> T <: (?ok_S, ?ok_S) -> ?ok_S;
assert ok_iterable: list[str] <: Iterable[?ok_S];
