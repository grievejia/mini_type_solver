# verdict: satisfiable
# Deep nesting: 12 levels of right-nested disjunctions. Every outer
# left branch is a true reflexive constraint; only the innermost atom
# is false. Direct search stops at the outermost true branch.
# Full-formula processing still measures parsing, DNF traversal, and
# linear Plaisted--Greenbaum encoding with one auxiliary variable per
# level instead of distributed copies.
class a;
class b;
class t0;
class t1;
class t2;
class t3;
class t4;
class t5;
class t6;
class t7;
class t8;
class t9;
class t10;
class t11;
assert deep: (t0 <: t0 or (t1 <: t1 or (t2 <: t2 or (t3 <: t3 or (t4 <: t4 or (t5 <: t5 or (t6 <: t6 or (t7 <: t7 or (t8 <: t8 or (t9 <: t9 or (t10 <: t10 or (t11 <: t11 or (a <: b)))))))))))));
